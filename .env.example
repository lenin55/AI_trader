# ==========================================
# TRADING BOT CONFIGURATION
# ==========================================

# Set to True ONLY if you want to place real trades. Default is False (Paper/Simulation).
LIVE_MODE=False

# ==========================================
# API CREDENTIALS
# ==========================================

# 1. Zerodha Kite Connect API
KITE_API_KEY="your_kite_api_key_here"
KITE_API_SECRET="your_kite_api_secret_here"
# Note: KITE_REQUEST_TOKEN changes daily unless you use an automated auth service
KITE_REQUEST_TOKEN="your_daily_kite_request_token_here"

# 2. NewsData.io API
NEWS_API_KEY="your_newsdata_api_key_here"

# 3. LLM APIs (Provide at least one. Priority: Grok > OpenAI > Gemini)
XAI_API_KEY="your_xai_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
GOOGLE_API_KEY="your_gemini_api_key_here"

# 4. Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# 5. Trading Capital (Dynamic Sizing)
# Sets the total capital for risk calculating algorithms (Default: 50000)
TOTAL_CAPITAL=50000
